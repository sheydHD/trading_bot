"""Feature engineering for stock / crypto price prediction.

Computes technical indicators, momentum metrics, and fundamental ratios
from raw OHLCV data downloaded via *yfinance*.
"""

from __future__ import annotations

import logging
from typing import Any

import numpy as np
import pandas as pd
import ta
import yfinance as yf

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Data fetching
# ---------------------------------------------------------------------------

def fetch_ohlcv(symbol: str, period: str = "2y") -> pd.DataFrame | None:
    """Download daily OHLCV data from Yahoo Finance.

    Returns a DataFrame with columns: Open, High, Low, Close, Volume.
    Returns *None* when no data is available.
    """
    try:
        data = yf.download(
            symbol, period=period, interval="1d",
            progress=False, auto_adjust=True,
        )
        if data.empty:
            logger.warning("No OHLCV data for %s", symbol)
            return None
        # Flatten MultiIndex columns produced by newer yfinance versions
        if isinstance(data.columns, pd.MultiIndex):
            data.columns = data.columns.get_level_values(0)
        return data
    except Exception as exc:
        logger.error("Failed to fetch OHLCV for %s: %s", symbol, exc)
        return None


def fetch_fundamentals(symbol: str) -> dict[str, Any]:
    """Fetch fundamental data via ``yf.Ticker(...).info``.

    Returns a flat dict (values may be *None* for unavailable metrics).
    """
    try:
        info = yf.Ticker(symbol).info
        return {
            "pe_ratio": info.get("trailingPE"),
            "forward_pe": info.get("forwardPE"),
            "peg_ratio": info.get("pegRatio"),
            "debt_to_equity": info.get("debtToEquity"),
            "return_on_equity": info.get("returnOnEquity"),
            "revenue_growth": info.get("revenueGrowth"),
            "earnings_growth": info.get("earningsGrowth"),
            "profit_margin": info.get("profitMargins"),
            "market_cap": info.get("marketCap"),
            "beta": info.get("beta"),
            "dividend_yield": info.get("dividendYield"),
            "current_price": info.get("currentPrice") or info.get("regularMarketPrice"),
            "fifty_two_week_high": info.get("fiftyTwoWeekHigh"),
            "fifty_two_week_low": info.get("fiftyTwoWeekLow"),
            "sector": info.get("sector", "Unknown"),
            "short_name": info.get("shortName", symbol),
        }
    except Exception as exc:
        logger.error("Failed to fetch fundamentals for %s: %s", symbol, exc)
        return {"sector": "Unknown", "short_name": symbol}


# ---------------------------------------------------------------------------
# Technical indicator computation
# ---------------------------------------------------------------------------

TECHNICAL_FEATURE_COLS: list[str] = [
    # Trend
    "price_vs_sma20", "price_vs_sma50", "price_vs_sma200",
    "macd", "macd_signal", "macd_hist", "adx",
    # Momentum
    "rsi_14", "stoch_k", "stoch_d",
    # Volatility
    "bb_pct", "atr_14",
    # Volume
    "volume_ratio",
    # Returns / vol
    "return_1d", "return_5d", "return_20d", "return_60d",
    "volatility_20d",
]

FUNDAMENTAL_FEATURE_COLS: list[str] = [
    "pe_ratio", "forward_pe", "peg_ratio",
    "debt_to_equity", "return_on_equity",
    "revenue_growth", "earnings_growth",
    "profit_margin", "beta", "log_market_cap",
]


def compute_technical_features(df: pd.DataFrame) -> pd.DataFrame:
    """Append technical-indicator columns to an OHLCV DataFrame (in-place copy)."""
    if df is None or df.empty:
        return pd.DataFrame()

    df = df.copy()
    close = df["Close"].squeeze()
    high = df["High"].squeeze()
    low = df["Low"].squeeze()
    volume = df["Volume"].squeeze().astype(float)

    # ---- Trend ----------------------------------------------------------
    df["sma_20"] = ta.trend.sma_indicator(close, window=20)
    df["sma_50"] = ta.trend.sma_indicator(close, window=50)
    df["sma_200"] = ta.trend.sma_indicator(close, window=200)
    df["ema_12"] = ta.trend.ema_indicator(close, window=12)
    df["ema_26"] = ta.trend.ema_indicator(close, window=26)

    df["price_vs_sma20"] = (close - df["sma_20"]) / df["sma_20"]
    df["price_vs_sma50"] = (close - df["sma_50"]) / df["sma_50"]
    df["price_vs_sma200"] = (close - df["sma_200"]) / df["sma_200"]

    macd_ind = ta.trend.MACD(close)
    df["macd"] = macd_ind.macd()
    df["macd_signal"] = macd_ind.macd_signal()
    df["macd_hist"] = macd_ind.macd_diff()

    adx_ind = ta.trend.ADXIndicator(high, low, close)
    df["adx"] = adx_ind.adx()

    # ---- Momentum -------------------------------------------------------
    df["rsi_14"] = ta.momentum.rsi(close, window=14)

    stoch = ta.momentum.StochasticOscillator(high, low, close)
    df["stoch_k"] = stoch.stoch()
    df["stoch_d"] = stoch.stoch_signal()

    # ---- Volatility -----------------------------------------------------
    bb = ta.volatility.BollingerBands(close)
    df["bb_high"] = bb.bollinger_hband()
    df["bb_low"] = bb.bollinger_lband()
    df["bb_pct"] = bb.bollinger_pband()     # % position within bands

    atr_ind = ta.volatility.AverageTrueRange(high, low, close)
    df["atr_14"] = atr_ind.average_true_range()

    # ---- Volume ---------------------------------------------------------
    df["volume_sma_20"] = ta.trend.sma_indicator(volume, window=20)
    df["volume_ratio"] = volume / df["volume_sma_20"].replace(0, np.nan)

    # ---- Returns & volatility -------------------------------------------
    df["return_1d"] = close.pct_change(1)
    df["return_5d"] = close.pct_change(5)
    df["return_20d"] = close.pct_change(20)
    df["return_60d"] = close.pct_change(60)
    df["volatility_20d"] = close.pct_change().rolling(20).std()

    return df


# ---------------------------------------------------------------------------
# Full feature matrix (technical + fundamental)
# ---------------------------------------------------------------------------

def build_feature_matrix(
    df: pd.DataFrame,
    fundamentals: dict[str, Any],
) -> tuple[pd.DataFrame, list[str]]:
    """Return ``(df_with_features, feature_column_names)``."""
    df = compute_technical_features(df)

    # Append fundamental fields as constant columns
    for col in FUNDAMENTAL_FEATURE_COLS:
        if col == "log_market_cap":
            mc = fundamentals.get("market_cap")
            df["log_market_cap"] = np.log(mc) if mc and mc > 0 else np.nan
        else:
            df[col] = fundamentals.get(col)

    all_feature_cols = TECHNICAL_FEATURE_COLS + FUNDAMENTAL_FEATURE_COLS
    return df, all_feature_cols


# ---------------------------------------------------------------------------
# Target variable
# ---------------------------------------------------------------------------

def create_target(df: pd.DataFrame, horizon: int = 5) -> pd.Series:
    """Binary target: 1 if price higher in *horizon* trading days, else 0."""
    close = df["Close"].squeeze()
    future_return = close.shift(-horizon) / close - 1
    target = (future_return > 0).astype(int)
    target.name = "target"
    return target
