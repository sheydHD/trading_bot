# ──────────────────────────────────────────────────────────────
# Trading Bot – Environment Configuration
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env with real secrets!
# ──────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email Notifications ─────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# ── API ──────────────────────────────────────────────────────
API_KEY=change-me-to-a-secure-key
ALLOWED_ORIGINS=http://localhost:3000
FLASK_ENV=production

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_API_URL=/api
VITE_API_KEY=change-me-to-a-secure-key

# ── Analysis ─────────────────────────────────────────────────
# light = fewer assets, faster  |  full = all assets
ANALYSIS_MODE=light
ENABLE_SENTIMENT=false
ENABLE_KALMAN=false
ENABLE_ML=false
MAX_WORKERS=3
MAX_STOCKS=30
MAX_CRYPTOS=15
